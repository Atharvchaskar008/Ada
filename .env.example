# ADA (Autonomous Talent Verification Engine) — Environment Configuration Template
# Copy this file to .env and fill in the values below.

# --- Backend Configuration ---
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ada_talent

# GitHub Personal Access Token (PAT)
# Required for high-rate-limit live repository discovery, commit telemetry, and author attribution
# Generate with read-only 'public_repo' scope at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here

# Google Gemini API Key
# Used for resume entity extraction, skill mapping, and telemetry-grounded claim auditing
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Maximum repositories scanned per candidate handle (supports deep pagination up to this limit)
MAX_REPOSITORIES_TO_SCAN=300

# --- Frontend Configuration (Next.js) ---
# Base URL for the Express backend API
NEXT_PUBLIC_API_URL=http://localhost:5000/api
