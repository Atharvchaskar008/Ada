# ADA Backend — Environment Configuration Template
# Place this in ada-backend/.env or rely on the root .env loaded at startup.

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ada_talent
GITHUB_TOKEN=your_github_personal_access_token_here
GEMINI_API_KEY=your_gemini_api_key_here
MAX_REPOSITORIES_TO_SCAN=300
